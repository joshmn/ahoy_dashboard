<!DOCTYPE html>
<html lang="en" data-bs-theme="dark" data-ask="<%= ask_panel.open? ? "open" : "shut" %>">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#08090a">
    <meta name="robots" content="noindex, nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <title><%= [ yield(:title).presence, dash_site_name ].compact.join(" - ") %></title>

    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%234f46e5'/%3E%3Crect x='8' y='16' width='4' height='9' rx='1' fill='%23ffffff'/%3E%3Crect x='14' y='11' width='4' height='14' rx='1' fill='%23ffffff'/%3E%3Crect x='20' y='7' width='4' height='18' rx='1' fill='%23ffffff'/%3E%3C/svg%3E">
    <%= dash_stylesheet_tag %>
    <%= dash_javascript_tag %>
  </head>

  <body data-controller="dash--palette dash--modal dash--ask" data-dash--ask-url-value="<%= ask_path %>">
    <%= dash_button "Skip to content", "#main", tone: :primary, class: "visually-hidden-focusable m-2" %>
    <div class="glow" aria-hidden="true"></div>

    <% settings = content_for?(:dash_settings_section) %>
    <% here = controller_path %>
    <% seo_here = seo_navigation? %>
    <% tabs = [
         { label: "Dashboard", icon: :empty, path: root_path(seo_here ? {} : query.to_query),
           current: here == "ahoy_dashboard/dashboards" },
         { label: "Explore", icon: :compass, path: explore_path(seo_here ? {} : query.to_query),
           current: here == "ahoy_dashboard/explores" },
         { label: "SEO", icon: :search, path: seo_path(seo_here ? query.to_query : {}),
           current: seo_here }
       ] %>

    <header class="hd navbar sticky-top">
      <div class="container-xxl hd-in">
        <%= link_to root_path, class: "site", title: "Dashboard", data: { tm_frame: "_top" } do %>
          <span class="mark" aria-hidden="true"></span>
          <span class="site-name"><%= dash_site_name %></span>
        <% end %>

        <nav class="hd-tabs" aria-label="Primary">
          <% tabs.each do |tab| %>
            <%= dash_button tab[:path],
                  class: "hd-nav",
                  "aria-current": ("page" if tab[:current]),
                  data: { tm_frame: "_top" } do %>
              <%= dash_icon(tab[:icon], size: 14) %>
              <span class="hd-nav-text"><%= tab[:label] %></span>
            <% end %>
          <% end %>
        </nav>

        <div class="hd-right">
          <%= dash_button palette.path, class: "search-btn",
                title: "Search and commands", "aria-haspopup": "dialog", "aria-controls": "tm-palette",
                data: { action: "dash--palette#toggle" } do %>
            <%= dash_icon(:search, size: 14) %>
            <span class="sb-text">Search</span>
            <kbd>&#8984;K</kbd>
          <% end %>

          <%= dash_frame_tag "dash_realtime" do %>
            <%= render "ahoy_dashboard/realtime/pill", visitors: @realtime %>
          <% end %>

          <%= yield :dash_header_controls %>

          <% if ask_screen? %>
            <%= dash_button chats_path, class: "hd-ask", title: "Ask", "aria-current": "page",
                  data: { tm_frame: "_top" } do %>
              <%= dash_icon(:chat, size: 14) %>
              <span class="hd-nav-text">Ask</span>
            <% end %>
          <% else %>
            <%= dash_button ask_path(ask_panel.params),
                  class: "hd-ask",
                  title: "Ask about this page",
                  "aria-expanded": ask_panel.open?.to_s,
                  "aria-controls": "dash-ask",
                  data: { "dash--ask-target": "opener", action: "dash--ask#toggle" } do %>
              <%= dash_icon(:chat, size: 14) %>
              <span class="hd-nav-text">Ask</span>
            <% end %>
          <% end %>

          <%= dash_icon_button :gear, label: "Settings", url: settings_goals_path,
                title: "Settings",
                "aria-current": ("page" if settings),
                data: { tm_frame: "_top" } %>
        </div>
      </div>
    </header>

    <% if content_for?(:dash_subnav) %>
      <div class="toolbar">
        <div class="container-xxl tb-in">
          <%= yield :dash_subnav %>
        </div>
      </div>
    <% end %>

    <main id="main" class="container-xxl">
      <%= render "ahoy_dashboard/shared/missing_tables", features: AhoyDashboard::Installation.switched_on_without_tables %>
      <% if settings %>
        <div class="set-wrap">
          <%= render "ahoy_dashboard/settings/shared/nav" %>
          <div class="set-main">
            <section class="sec">
              <%= yield %>
            </section>
          </div>
        </div>
      <% else %>
        <%= yield %>
      <% end %>
    </main>

    <footer class="ft">
      <div class="container-xxl ft-in">
        <span>Powered by AhoyDashboard v<%= AhoyDashboard::VERSION %></span>
      </div>
    </footer>

    <%= render "ahoy_dashboard/shared/ask", panel: ask_panel unless ask_screen? %>
    <%= render "ahoy_dashboard/shared/palette" %>
    <%= yield :dash_dialogs %>

    <% if flash[:notice].present? || flash[:alert].present? %>
      <%= dash_toast flash[:alert].presence || flash[:notice], tone: flash[:alert].present? ? :danger : :success %>
    <% end %>
  </body>
</html>
