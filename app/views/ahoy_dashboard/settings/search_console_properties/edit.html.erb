<% content_for :title, "Search Console property" %>
<% content_for :dash_settings_section, "search_console" %>

<div class="set-main">
  <section class="sec">
    <%= dash_page_head title: "Pick a property",
          lede: "Choose the Search Console property that matches this site. A domain property covers every subdomain and both http and https." %>

    <%= dash_card do %>
      <% if @sites.any? %>
        <%= dash_form_with model: @form, scope: :property, url: settings_search_console_property_path,
              method: :patch, card: true do |form| %>
          <%= form.error_summary "Nothing was saved." %>

          <% if @stored_days.positive? %>
            <%= dash_notice "Switching deletes what is stored.", tone: :warning,
                  detail: "The #{pluralize(@stored_days, "day")} already pulled belong to " \
                          "#{@stored_property.delete_prefix(AhoyDashboard::GoogleAccount::DOMAIN_PREFIX)}. " \
                          "Pick a different property and they are removed, then history is pulled again for the new one." %>
          <% end %>

          <%= form.select :property_uri,
                @sites.map { |site| [ site.domain? ? "#{site.label} (domain)" : site.label, site.url ] },
                { include_blank: "Choose one" },
                label: "Property", hint: "Pick the one that matches how the site is verified in Search Console." %>

          <%= form.actions "Save property", cancel: settings_google_connection_path %>
        <% end %>
      <% else %>
        <% if @form.errors.any? %>
          <%= dash_notice "Nothing was saved.", detail: @form.errors.full_messages.to_sentence, tone: :danger, class: "m-3" %>
        <% end %>
        <%= dash_empty title: "No properties this account can read",
              hint: "Verify the site in Search Console with this Google account, then come back.",
              action: { label: "Back to Search Console", url: settings_google_connection_path, primary: false } %>
      <% end %>
    <% end %>
  </section>
</div>
