<% content_for :title, "Excluded traffic" %>
<% content_for :dash_settings_section, "exclusions" %>

<%= dash_page_head title: "Excluded traffic",
      lede: "Visits that match any of these are left out of every number on the dashboard, the emails and the alerts. " \
            "There's a switch on the dashboard to show them again when you want to look.",
      actions: dash_button("New exclusion", new_settings_exclusion_path, tone: :primary, icon: :plus) %>

<%= dash_card do %>
  <% if @exclusions.any? %>
    <%= dash_card_header "#{@exclusions.size} #{"exclusion".pluralize(@exclusions.size)}" %>

    <%= dash_table label: "Exclusions", cols: "minmax(0, .8fr) minmax(0, 1.5fr) 150px 96px 92px" do %>
      <thead>
        <tr>
          <th scope="col">Exclusion</th>
          <th scope="col">Rule</th>
          <th scope="col">Hid</th>
          <th scope="col">State</th>
          <th scope="col"><span class="visually-hidden">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% @exclusions.each_with_index do |exclusion, index| %>
          <% if confirming?(exclusion) %>
            <%= dash_delete_confirm exclusion.name, "The visits it hides will count again.",
                  url: settings_exclusion_path(exclusion), cancel: settings_exclusions_path, span: 5 %>
          <% else %>
            <tr>
              <td>
                <span class="t-main">
                  <%= dash_icon(:filter, size: 13, class_name: "gi") %>
                  <b><%= exclusion.name %></b>
                </span>
              </td>

              <td class="t-when"><%= exclusion.rule %></td>

              <td class="t-when"><%= exclusion.count_label %></td>

              <td>
                <% if exclusion.readable? %>
                  <%= dash_button_to exclusion.state_label, settings_exclusion_state_path(exclusion),
                        method: :patch, params: { enabled: exclusion.enabled ? "0" : "1" },
                        tone: exclusion.enabled ? :primary : :secondary,
                        "aria-label": exclusion.switch_label, title: exclusion.switch_label %>
                <% else %>
                  <%= dash_badge exclusion.state_label, tone: :danger %>
                <% end %>
              </td>

              <td class="row-actions">
                <%= dash_edit_button exclusion.name, edit_settings_exclusion_path(exclusion) %>
                <%= dash_delete_button exclusion.name, settings_exclusions_path(confirm: exclusion.id) %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    <% end %>
  <% else %>
    <%= dash_empty title: "Nothing is excluded yet",
          hint: "An exclusion hides traffic you don't want counted, like bots coming from a data center. " \
                "The quickest way to make one is from the dashboard: filter down to the traffic, say a network " \
                "or an IP address, then open Filter and pick \"Hide traffic like this...\".",
          action: { label: "New exclusion", url: new_settings_exclusion_path } %>
  <% end %>
<% end %>
