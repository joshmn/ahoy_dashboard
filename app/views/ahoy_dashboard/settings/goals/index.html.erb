<% content_for :title, "Goals" %>
<% content_for :dash_settings_section, "goals" %>

<%= dash_page_head title: "Goals",
      lede: "The conversions you care about. New goals count past data too.",
      actions: dash_button("New goal", new_settings_goal_path, tone: :primary, icon: :plus) %>

<%= dash_card do %>
  <% if @goals.any? %>
    <%= dash_card_header "#{@goals.size} #{"goal".pluralize(@goals.size)}" do %>
      <span class="g-hint"><%= @presenter&.range_label || query.range_label %></span>
    <% end %>

    <%= dash_table label: "Goals", cols: "minmax(0, 1.15fr) 104px minmax(0, 1fr) 96px 64px 56px 64px" do %>
      <thead>
        <tr>
          <th scope="col">Goal</th>
          <th scope="col">Type</th>
          <th scope="col">Matches</th>
          <th scope="col" class="num">Conversions</th>
          <th scope="col" class="num">Rate</th>
          <th scope="col"><span class="visually-hidden">Order</span></th>
          <th scope="col"><span class="visually-hidden">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% @goals.each_with_index do |goal, index| %>
          <% if confirming?(goal) %>
            <%= dash_delete_confirm goal.name, "Past conversions stay in your stats.",
                  url: settings_goal_path(goal), cancel: settings_goals_path, span: 7 %>
          <% else %>
            <% row = @conversions[goal.name] %>
            <tr>
              <td>
                <div class="t-main">
                  <b><%= goal.name %></b>
                  <% if goal.revenue? %>
                    <%= dash_badge goal.currency, tone: :kind, title: "Revenue from the event's properties" %>
                  <% end %>
                </div>
              </td>

              <td>
                <%= dash_badge goal.kind_label, tone: :kind %>
              </td>

              <td>
                <div class="t-mono"><%= goal.matcher %></div>
                <% if goal.property_key.present? %>
                  <div class="t-mono"><%= goal.property_key %>: <%= goal.property_value %></div>
                <% end %>
              </td>

              <td class="num"><%= row ? dash_number(row.metrics["visitors"]) : "0" %></td>
              <td class="num t2">
                <%= AhoyDashboard::Metric.find("conversion_rate").format(row&.metrics&.dig("conversion_rate").to_f) %>
              </td>

              <td class="row-actions">
                <%= dash_move_buttons settings_goal_path(goal), name: goal.name, param: :goal,
                      index: index, count: @goals.size %>
              </td>

              <td class="row-actions">
                <%= dash_edit_button goal.name, edit_settings_goal_path(goal) %>
                <%= dash_delete_button goal.name, settings_goals_path(confirm: goal.id) %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    <% end %>
  <% else %>
    <%= dash_empty title: "No goals yet",
          hint: "Count a signup, a purchase or a visit to a key page.",
          action: { label: "New goal", url: new_settings_goal_path } %>
  <% end %>
<% end %>
