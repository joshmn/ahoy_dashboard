<% visible = local_assigns.key?(:value) %>
<% options = { label: label, mono: true, hint: local_assigns.fetch(:hint) { secret.hint } } %>
<% options[:optional] = optional if local_assigns.key?(:optional) %>
<% if local_assigns.fetch(:nested, true) %>
  <% options.merge!(id: "#{form.object_name}_credentials_#{secret.key}", name: "#{form.object_name}[credentials][#{secret.key}]") %>
<% end %>
<% options[:value] = value if visible %>
<% options[:autocomplete] = "off" %>
<% if secret.stored? %>
  <% options[:append] = dash_button("Remove", remove_url, size: :md, aria: { label: "Remove the stored #{secret.label}" }) %>
<% end %>
<%= visible ? form.text_field(secret.key, options) : form.password_field(secret.key, options) %>
