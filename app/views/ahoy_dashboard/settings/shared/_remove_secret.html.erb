<%= dash_notice tone: :warning, id: "remove-secret", class: "mx-3 mt-3 mb-0",
      action: tag.div(safe_join([
        dash_button_to("Remove", url, method: :delete, tone: :danger),
        dash_button("Cancel", cancel, tone: :link, autofocus: true)
      ]), class: "d-flex flex-wrap align-items-center gap-2") do %>
  <%= secret.question %>
<% end %>
