<% content_for :dash_header_controls do %>
  <%= dash_link_menu(id: "tm-period",
        icon: :cal,
        label: query.period_label,
        section: "Date range",
        items: AhoyDashboard::PeriodMenu.items(query: query) { |period, seed|
          root_path(query.to_query.merge(period: period.key).except(:from, :to).merge(seed))
        }.map(&:to_menu_item)) %>
<% end %>

<div class="toolbar">
  <div class="container-xxl tb-in px-0">
  <div class="d-flex flex-wrap align-items-center gap-1">
    <%= render "ahoy_dashboard/dashboards/filter_menu" %>

    <div class="chips">
      <% remove_path = ->(index) { root_path(query.without_filter_params(index)) } %>
      <% query.filters.groups.zip(query.filters.group_starts).each do |group, start| %>
        <%= render "ahoy_dashboard/shared/filter_group", group: group, start: start, remove_path: remove_path %>
      <% end %>

      <% if query.defaulted? %>
        <%= render "ahoy_dashboard/shared/defaulted_note", url: root_path(query.default_clear_params),
              class_name: "d-inline-flex align-items-center gap-2 small text-body-secondary" %>
      <% end %>
    </div>
  </div>

  <% if !local_assigns[:deferred] && @presenter.computed_at %>
    <span class="tb-hint" id="dash-snapshot-freshness">
      Snapshot updated <%= time_tag(@presenter.computed_at, @presenter.computed_at_label) %>
    </span>
  <% end %>

  <div class="d-flex align-items-center gap-2 ms-auto">
    <% if !local_assigns[:deferred] && query.hidden_visits.positive? %>
      <span class="tb-hint"><%= pluralize(query.hidden_visits, "visit") %> hidden</span>
      <%= dash_button "Show them", root_path(query.internal_toggle_params), tone: :link %>
      <%= dash_button "Manage", settings_exclusions_path, tone: :link,
            "aria-label": "Manage exclusions" %>
    <% end %>

    <% if query.filters.none? %>
      <span class="tb-hint">Click any row to drill down</span>
    <% else %>
      <%= dash_button "Clear filters", root_path(query.with(filters: nil).to_query), tone: :link %>
    <% end %>

    <% if remembered_view? %>
      <%= dash_button_to "Reset view", view_path, method: :delete, tone: :link,
            title: "Showing your last view. Reset to the last 30 days with no filters." %>
    <% end %>
  </div>

  </div>
</div>

<% if query.period.custom? %>
  <%= render "ahoy_dashboard/shared/range_fields",
        url: root_path,
        clear_path: root_path(query.with(period: AhoyDashboard::Period::DEFAULT_KEY).to_query) %>
<% end %>
