<% comparing = @presenter.comparing? %>
<% comparison_label = @presenter.comparison_switch_label %>

<div class="stat-row">
  <%= form_with url: root_path,
        method: :get,
        data: { tm_frame: "_top", controller: "dash--metric",
                "dash--metric-url-value": dashboard_path(format: :json) } do %>
    <%= render "ahoy_dashboard/shared/query_fields", except: [ :metric ] %>

    <%= dash_tiles label: "Metrics" do %>
      <% @presenter.tiles.each do |tile| %>
        <%= dash_tile tile.label, tile.display,
              button: true, current: tile.active?, delta: tile.delta, value_title: tile.full,
              name: "metric", value: tile.key,
              data: { action: "dash--metric#select", "dash--metric-key-param": tile.key } %>
      <% end %>
    <% end %>
  <% end %>

  <div class="chart-controls">
    <%= link_to @presenter.comparison_switch_path,
          class: "cmp",
          role: "switch", data: { tm_frame: "_top" },
          "aria-checked": comparing.to_s,
          title: comparing ? "Stop comparing" : "Compare to #{comparison_label.downcase}" do %>
      <span class="cmp-lbl"><%= comparison_label %></span>
      <span class="form-check form-switch bs-switch"><i></i></span>
    <% end %>

    <%= dash_icon_button :download,
          label: "Download this chart as CSV",
          title: "Download CSV",
          data: { action: "dash--chart#export" } %>
  </div>
</div>
