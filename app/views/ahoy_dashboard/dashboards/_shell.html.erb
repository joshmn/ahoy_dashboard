<% summary = AhoyDashboard::Dashboards::SummariesController::FRAME %>
<%= render "ahoy_dashboard/dashboards/bar", deferred: true %>

<noscript>
  <p><%= link_to "Load the complete dashboard", root_path(query.to_query.merge(loading: "complete")) %></p>
</noscript>

<%= dash_frame_tag summary, src: dashboard_summary_path(query.to_query), data: { tm_priority: "high" } do %>
  <%= render "ahoy_dashboard/dashboards/skeleton", title: "traffic over time", modifier: "dash-panel-skeleton--summary" %>
<% end %>

<% if @presenter.pinned? %>
  <%= dash_frame_tag AhoyDashboard::PinnedQuestionsController::FRAME, src: pinned_questions_path(query.to_query),
        loading: "lazy", data: { tm_after: summary } do %>
    <%= render "ahoy_dashboard/dashboards/skeleton", title: "pinned questions", modifier: "dash-panel-skeleton--compact" %>
  <% end %>
<% end %>

<section class="grid row" id="panels" aria-label="Reports">
  <% @presenter.grid_reports.each do |report| %>
    <div class="col-6 panel-col">
      <%= dash_frame_tag AhoyDashboard::ReportPresenter.frame_id(report), src: report_path(report.key, query.to_query),
            loading: "lazy", data: { tm_after: summary } do %>
        <%= render "ahoy_dashboard/dashboards/skeleton", title: report.title, modifier: "dash-panel-skeleton--report" %>
      <% end %>
    </div>
  <% end %>
  <div class="col-6 panel-col">
    <%= dash_frame_tag AhoyDashboard::SearchConsolePresenter::FRAME, src: search_console_path(query.to_query),
          loading: "lazy", data: { tm_after: summary } do %>
      <%= render "ahoy_dashboard/dashboards/skeleton", title: AhoyDashboard::SearchConsolePresenter::TITLE %>
    <% end %>
  </div>
  <% @presenter.funnels.each do |funnel| %>
    <div class="col-6 panel-col">
      <%= dash_frame_tag AhoyDashboard::FunnelPresenter.frame_id(funnel), src: funnel_path(funnel, query.to_query),
            loading: "lazy", data: { tm_after: summary } do %>
        <%= render "ahoy_dashboard/dashboards/skeleton", title: funnel.name %>
      <% end %>
    </div>
  <% end %>
</section>

<%= render "ahoy_dashboard/dashboards/more_funnels" %>

<%= dash_frame_tag AhoyDashboard::JourneyPresenter::FRAME, src: journey_path(query.to_query), loading: "lazy",
      data: { tm_after: summary } do %>
  <%= render "ahoy_dashboard/dashboards/skeleton", title: "page journey" %>
<% end %>
<%= dash_frame_tag AhoyDashboard::GoalConversionsPresenter::FRAME, src: goal_conversions_path(query.to_query),
      loading: "lazy", data: { tm_after: summary } do %>
  <%= render "ahoy_dashboard/dashboards/skeleton", title: "goal conversions" %>
<% end %>

<%= render "ahoy_dashboard/dashboards/dialogs" %>
