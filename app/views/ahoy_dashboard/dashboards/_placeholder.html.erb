<%# The skeleton a report card's frame is replaced with, in the same shape: a
    46px head with the title in it and a list under it, so nothing on the page
    moves when the real card lands. %>
<%= dash_card element: :section, class: "panel h-100", "aria-busy": "true" do %>
  <%= dash_card_header report.title, element: :header %>

  <div class="p-list placeholder-glow" aria-hidden="true">
    <% [ 12, 10, 8, 7, 6, 5, 4, 3, 3 ].each do |width| %>
      <span class="placeholder col-<%= width %> rounded py-2"></span>
    <% end %>
  </div>

  <span class="visually-hidden">Loading <%= report.title.downcase %></span>
<% end %>
