<% chart_data = @presenter.chart_data %>
<% chart_options = (@presenter.chart_options || {}).symbolize_keys %>

<%= dash_card element: :section, class: "chart-card",
      "aria-label": "Traffic over time",
      data: dash_chart_data(chart_data, chart_options) do %>
  <%= render "ahoy_dashboard/dashboards/stats" %>

  <div class="chart-wrap" data-dash--chart-target="canvas">
    <% if chart_data.blank? %>
      <%= dash_empty fill: true,
            title: "No visits in this range",
            hint: dash_range_hint %>
    <% end %>
  </div>
<% end %>
