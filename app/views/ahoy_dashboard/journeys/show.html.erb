<% content_for :title, @presenter.title %>

<%= dash_page_head title: @presenter.title,
      lede: "Where visitors went after any page they viewed.",
      actions: dash_button("Back to dashboard", root_path(query.to_query), data: { tm_frame: "_top" }) %>

<%= dash_frame_tag AhoyDashboard::JourneyPresenter::FRAME do %>
  <%= render "ahoy_dashboard/journeys/card", presenter: @presenter %>
<% end %>
