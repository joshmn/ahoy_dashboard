<% font = AhoyDashboard::DigestMailing::FONT %>
<% content_for :preheader, @digest.preheader %>
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width: 100%; max-width: 600px; background-color: #ffffff; border: 1px solid #e2e4e9; border-radius: 10px;">
  <%= render "ahoy_dashboard/digest_mail/header", digest: @digest, noun: "traffic" %>
  <%= render layout: "ahoy_dashboard/digest_mail/hero", locals: { digest: @digest, bottom: 8 } do %>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <%= render "ahoy_dashboard/digest_mail/button", label: "Open the dashboard", url: @dashboard_url %>
      </tr>
    </table>
  <% end %>
  <tr>
    <td style="padding: 16px 16px 8px; <%= font %>">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <% @digest.tiles.each_slice(2) do |pair| %>
          <tr>
            <% pair.each do |tile| %>
              <td width="50%" style="padding: 8px; vertical-align: top;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border: 1px solid #eceef2; border-radius: 8px;">
                  <tr>
                    <td style="padding: 14px 16px; <%= font %>">
                      <div style="font-size: 12px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: #6b7280;"><%= tile.label %></div>
                      <div style="padding-top: 4px; font-size: 24px; line-height: 1.2; font-weight: 600; color: #111318;"><%= link_to tile.value, @tile_urls[tile.key], style: "color: #111318; text-decoration: none;" %></div>
                      <% if tile.change %>
                        <div style="padding-top: 4px; font-size: 13px; color: <%= tile.color %>;"><%= tile.change %></div>
                      <% end %>
                    </td>
                  </tr>
                </table>
              </td>
            <% end %>
          </tr>
        <% end %>
      </table>
    </td>
  </tr>
  <% if @digest.nothing_listed? %>
    <tr>
      <td style="padding: 8px 24px 24px; font-size: 14px; line-height: 1.5; color: #4b5563; <%= font %>"><%= @digest.nothing_listed_note %></td>
    </tr>
  <% else %>
    <% @digest.lists.each do |list| %>
      <tr>
        <td style="padding: 8px 24px 16px; <%= font %>">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td style="padding: 12px 0 4px; font-size: 15px; font-weight: 600; color: #111318; <%= font %>"><%= list.title %></td>
              <td align="right" style="padding: 12px 0 4px; font-size: 13px; <%= font %>"><%= link_to "See all", @list_urls[list.key], style: "color: #4f5bd5; text-decoration: underline;" %></td>
            </tr>
            <% list.rows.each do |row| %>
              <tr>
                <td style="padding: 10px 0 4px; border-top: 1px solid #eceef2; font-size: 14px; line-height: 1.4; color: #3f4652; word-break: break-all; <%= font %>"><%= truncate(row.label, length: 52) %></td>
                <td width="96" align="right" style="padding: 10px 0 4px 12px; border-top: 1px solid #eceef2; font-size: 14px; color: #111318; white-space: nowrap; <%= font %>"><%= row.value %></td>
              </tr>
              <tr>
                <td colspan="2" style="padding: 0 0 6px;">
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #eef0f3; border-radius: 2px;">
                    <tr>
                      <td width="<%= row.share %>%" height="3" style="background-color: #c7cbf0; border-radius: 2px; font-size: 0; line-height: 0;">&nbsp;</td>
                      <td height="3" style="font-size: 0; line-height: 0;">&nbsp;</td>
                    </tr>
                  </table>
                </td>
              </tr>
            <% end %>
          </table>
        </td>
      </tr>
    <% end %>
  <% end %>
  <%= render layout: "ahoy_dashboard/digest_mail/footer" do %>
    <%= @digest.scope_note %> <%= @digest.footer %>
  <% end %>
</table>
