<% content_for :title, @presenter.title %>

<%= render layout: "ahoy_dashboard/seo/shared/shell", locals: { current: "position_changes", site: @site } do %>
  <%= render "ahoy_dashboard/seo/shared/head", presenter: @presenter %>

  <% if !@presenter.any? %>
    <%= dash_empty_card **@presenter.rank_empty %>
  <% else %>
    <% unless @presenter.comparable? %>
      <%= dash_empty_card card_class: "seo-notice-card", compact: true, title: "Only one reading in this range",
            hint: "Changes need at least two checks. Try a longer date range." %>
    <% end %>

    <%= dash_card class: "seo-moves" do %>
      <div class="seo-moves__bar" role="img" aria-label="<%= @presenter.moves_label %>">
        <% @presenter.moves.each do |move| %>
          <% next if move.count.zero? %>
          <span class="seo-moves__seg seo-move--<%= move.key %>" style="--n: <%= move.count %>"></span>
        <% end %>
      </div>

      <ul class="seo-moves__legend">
        <% @presenter.moves.each do |move| %>
          <li>
            <%= content_tag(move.count.positive? ? :a : :div,
                  href: (move.count.positive? ? "##{@presenter.anchor(move.key)}" : nil),
                  class: class_names("seo-moves__item", "seo-move--#{move.key}",
                                     "seo-moves__item--zero" => move.count.zero?)) do %>
              <span class="seo-moves__label"><span class="seo-moves__swatch" aria-hidden="true"></span><%= move.label %></span>
              <span class="seo-moves__n"><%= @presenter.number(move.count) %></span>
            <% end %>
          </li>
        <% end %>
      </ul>

      <p class="seo-moves__foot"><%= @presenter.crossings_note %></p>
    <% end %>

    <% @presenter.groups.each do |group| %>
      <%= dash_card element: :section, class: "mt-3 seo-group", id: @presenter.anchor(group.key) do %>
        <%= seo_group_header(@presenter, group) %>

        <%= dash_table label: group.title, cols: @presenter.table_cols do %>
          <thead>
            <tr>
              <th scope="col">Search</th>
              <% if @presenter.places? %><th scope="col">Place</th><% end %>
              <th scope="col" class="num">Was</th>
              <th scope="col" class="num">Now</th>
              <th scope="col">Change</th>
              <th scope="col">URL</th>
              <% if @presenter.windows? %><th scope="col">Between</th><% end %>
            </tr>
          </thead>
          <tbody>
            <% group.rows.each do |row| %>
              <tr>
                <td><div class="t-main"><%= seo_link(row.query, @presenter.tracked_path(row)) %></div></td>
                <% if @presenter.places? %>
                  <td><%= seo_label(row.place.label) %></td>
                <% end %>
                <td class="num <%= row.from ? "t2" : "nil" %>"><%= @presenter.position_label(row.from) %></td>
                <td class="num <%= row.to ? "seo-pos" : "nil" %>"><%= @presenter.position_label(row.to) %></td>
                <td>
                  <%= render "ahoy_dashboard/seo/shared/change", kind: @presenter.change_kind(row), amount: row.change&.abs %>
                </td>
                <td><%= seo_page_link(row.url) %></td>
                <% if @presenter.windows? %>
                  <td class="small text-body-secondary"><%= @presenter.window(row) %></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        <% end %>
      <% end %>
    <% end %>

    <% if @presenter.unranked.any? %>
      <%= dash_card element: :section, class: "mt-3 seo-group", id: @presenter.anchor(:unranked) do %>
        <%= seo_group_header(@presenter, @presenter.unranked_group) %>

        <div class="seo-chips">
          <% @presenter.unranked.each do |row| %>
            <%= link_to @presenter.tracked_path(row), class: "seo-chip", title: row.query, data: { tm_frame: "_top" } do %>
              <span class="nm"><%= row.query %></span>
              <% if @presenter.places? %><span class="seo-chip__n"><%= row.place.label %></span><% end %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <p class="seo-foot">
      Each change compares the first reading in the range with the last.
      <%= @presenter.window_note %>
    </p>
  <% end %>
<% end %>
