<% content_for :title, @presenter.title %>

<%= render layout: "ahoy_dashboard/seo/shared/shell", locals: { current: "landing_pages", site: @site } do %>
  <%= render "ahoy_dashboard/seo/shared/head", presenter: @presenter %>

  <% if !@presenter.any? %>
    <%= dash_card do %>
      <%= dash_empty **@presenter.rank_empty %>
    <% end %>
  <% else %>
    <%= render "ahoy_dashboard/seo/shared/tiles", tiles: @presenter.tiles %>

    <%= dash_card element: :section, class: "mt-3", id: "landing-pages", aria: { labelledby: "landing-pages-title" } do %>
      <%= dash_card_header "Pages carrying your rankings", id: "landing-pages-title" do %>
        <span class="g-hint">Biggest share first</span>
        <% if @presenter.pages.any? %>
          <%= seo_csv(@presenter, "pages", label: "Pages CSV") %>
          <%= seo_csv(@presenter, "held", label: "Searches CSV") %>
        <% end %>
      <% end %>

      <% if @presenter.pages.empty? %>
        <%= dash_empty compact: true, title: "No page ranks on the latest reading",
              hint: "Every page that held a search earlier in the range is listed below." %>
      <% else %>
        <%= dash_table label: "Pages carrying your rankings", cols: @presenter.table_cols do %>
          <thead>
            <tr>
              <th scope="col">URL</th>
              <th scope="col" class="num">Searches</th>
              <th scope="col" class="num">Best</th>
              <th scope="col" class="num">Median</th>
              <th scope="col">Share of visibility</th>
            </tr>
          </thead>
          <tbody>
            <% @presenter.pages.each do |page| %>
              <tr>
                <td>
                  <div class="t-main"><%= seo_page_link(@presenter.path_of(page.url)) %></div>
                  <%= dash_disclosure "#{@presenter.searches_label(page)} held", less: "Hide searches" do %>
                    <ul class="list-unstyled mb-0 mt-1 small">
                      <% page.held.each do |held| %>
                        <li class="d-flex gap-2 min-w-0">
                          <span class="seo-pos"><%= held.position %></span>
                          <%= seo_link(held.query, @presenter.tracked_path(held)) %>
                          <% if @presenter.places? %><span class="text-body-tertiary"><%= held.place.label %></span><% end %>
                        </li>
                      <% end %>
                    </ul>
                  <% end %>
                </td>
                <td class="num"><%= @presenter.number(page.searches) %></td>
                <td class="num seo-pos"><%= page.best %></td>
                <td class="num"><%= page.median %></td>
                <td>
                  <div class="seo-figure">
                    <%= tag.span(class: "seo-meter", **seo_bar(page.share)) %>
                    <span class="seo-figure__pct"><%= @presenter.share_label(page) %></span>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        <% end %>
      <% end %>

      <%= dash_card_footer do %>
        <%= @presenter.points_note %>
        <%= @presenter.unheld_note %>
      <% end %>
    <% end %>

    <% if @presenter.lost.any? %>
      <%= dash_card element: :section, class: "mt-3", id: "landing-pages-lost", aria: { labelledby: "landing-pages-lost-title" } do %>
        <%= dash_card_header "Lost every search", id: "landing-pages-lost-title" do %>
          <span class="g-hint">Held a search earlier in the range, holds none now</span>
          <%= seo_csv(@presenter, "lost") %>
        <% end %>

        <% @presenter.lost.each do |page| %>
          <div class="px-3 pt-3">
            <div class="t-main"><%= seo_page_link(@presenter.path_of(page.url)) %></div>
          </div>

          <%= dash_table label: "Searches #{@presenter.path_of(page.url)} lost", cols: @presenter.lost_cols do %>
            <thead>
              <tr>
                <th scope="col">Search</th>
                <% if @presenter.places? %><th scope="col">Place</th><% end %>
                <th scope="col" class="num">Was</th>
                <th scope="col">Now</th>
              </tr>
            </thead>
            <tbody>
              <% page.gone.each do |row| %>
                <tr>
                  <td><div class="t-main"><%= seo_link(row.query, @presenter.tracked_path(row)) %></div></td>
                  <% if @presenter.places? %><td><%= seo_label(row.place.label) %></td><% end %>
                  <td class="num t2"><%= row.was %></td>
                  <td class="<%= "nil" unless row.ranked_elsewhere? %>"><%= @presenter.gone_now(row) %></td>
                </tr>
              <% end %>
            </tbody>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <p class="seo-foot">
      Each search counts once, at its latest reading in the range. URLs are compared as the search provider returns them,
      so the same page with and without a trailing slash is two rows.
    </p>
  <% end %>
<% end %>
