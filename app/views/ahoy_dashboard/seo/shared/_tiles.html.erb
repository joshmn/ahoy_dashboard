<% bare = local_assigns[:bare] %>
<% stats = capture do %>
  <%= dash_tiles label: "Summary figures" do %>
    <% tiles.each do |tile| %>
      <%= dash_tile tile.label, tile.value,
            url: tile.url, status: tile.kind == :status,
            delta: ({ text: tile.note, tone: tile.tone } if tile.tone.present? && tile.note.present?),
            note: (tile.note if tile.tone.blank?) %>
    <% end %>
  <% end %>
<% end %>
<% if bare %>
<%= stats %>
<% else %>
<%= dash_card(class: local_assigns[:card_class]) { stats } %>
<% end %>
