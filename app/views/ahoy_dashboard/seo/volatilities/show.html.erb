<% content_for :title, "Volatility" %>

<%= render layout: "ahoy_dashboard/seo/shared/shell", locals: { current: "volatility", site: @site } do %>
  <%= render "ahoy_dashboard/seo/shared/head", presenter: @presenter, sites: false %>

  <% if !@presenter.any? %>
    <%= dash_empty_card **@presenter.rank_empty(title: "Not enough readings yet",
                                       hint: "Volatility compares two checks of the same search. Try a longer date range.") %>
  <% else %>
    <%= render "ahoy_dashboard/seo/shared/tiles", tiles: @presenter.tiles %>

    <%= dash_card class: "mt-3" do %>
      <%= dash_card_header "Volatility over time" do %>
        <span class="g-hint">Across your tracked searches</span>
      <% end %>

      <%= render "ahoy_dashboard/seo/shared/plot", points: @presenter.points,
            label: "Volatility over the range", height: 120, floor: 0, ceiling: 100, bands: @presenter.level_scale %>

      <dl class="seo-scale">
        <% @presenter.level_scale.each_cons(2) do |(floor, label), (ceiling, _next)| %>
          <div class="seo-scale__item"><dt><%= label %></dt><dd><%= floor %> to <%= ceiling %></dd></div>
        <% end %>
        <div class="seo-scale__item">
          <dt><%= @presenter.level_scale.last.last %></dt><dd><%= @presenter.level_scale.last.first %> and up</dd>
        </div>
      </dl>

      <%= dash_card_footer do %>Scored 0 to 100. A score of 100 means the results changed completely between checks.<% end %>
    <% end %>

    <%= dash_card class: "mt-3" do %>
      <%= dash_card_header "Most changed searches" do %>
        <span class="g-hint">Highest score first</span>
        <%= seo_csv(@presenter, "searches") %>
      <% end %>

      <%= dash_table label: "Most changed searches", cols: "minmax(0, 1.5fr) 88px 72px 88px 80px minmax(0, 1.2fr)" do %>
        <thead>
          <tr>
            <th scope="col">Search</th>
            <th scope="col">Day</th>
            <th scope="col" class="num">Score</th>
            <th scope="col" class="num">Turnover</th>
            <th scope="col" class="num">Shuffle</th>
            <th scope="col" class="ps-2">New on the page</th>
          </tr>
        </thead>
        <tbody>
          <%= render partial: "ahoy_dashboard/seo/volatilities/busy", collection: @presenter.busiest_head,
                as: :busy, locals: { presenter: @presenter } %>
        </tbody>
      <% end %>

      <% if @presenter.busiest_rest.any? %>
        <%= dash_disclosure "Show #{@presenter.busiest_rest.size} more", less: "Show fewer", bar: true do %>
          <%= dash_table label: "More searches", cols: "minmax(0, 1.5fr) 88px 72px 88px 80px minmax(0, 1.2fr)" do %>
            <tbody>
              <%= render partial: "ahoy_dashboard/seo/volatilities/busy", collection: @presenter.busiest_rest,
                    as: :busy, locals: { presenter: @presenter } %>
            </tbody>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
