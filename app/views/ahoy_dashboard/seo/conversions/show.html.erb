<% content_for :title, "Search to conversion" %>

<%= render layout: "ahoy_dashboard/seo/shared/shell", locals: { current: "conversions", site: @site } do %>
  <%= render "ahoy_dashboard/seo/shared/head", presenter: @presenter, sites: false %>

  <% if !@presenter.any? %>
    <%= dash_empty_card **@presenter.search_console_empty(title: "Nothing to match up yet",
                                                 hint: "This needs Search Console data and visits from search in the same range.") %>
  <% else %>
    <% unless @presenter.goals? %>
      <%= dash_empty_card card_class: "seo-notice-card", compact: true, **@presenter.goal_notice %>
    <% end %>

    <%= render "ahoy_dashboard/seo/shared/tiles", tiles: @presenter.tiles %>

    <%= dash_card class: "mt-3" do %>
      <%= dash_card_header "Pages, searches and conversions" do %>
        <span class="g-hint">Most clicks first</span>
        <% if @presenter.rows.any? %>
          <%= seo_csv(@presenter, "pages") %>
        <% end %>
      <% end %>

      <%= dash_table label: "Pages, searches and conversions", cols: @presenter.table_cols do %>
        <thead>
          <tr>
            <th scope="col">Page</th>
            <th scope="col">Top search</th>
            <th scope="col" class="num">Clicks</th>
            <th scope="col" class="num">Visits</th>
            <% if @presenter.goals? %>
              <th scope="col" class="num">Converting visits</th>
              <th scope="col" class="num">Rate</th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @presenter.rows.each do |row| %>
            <tr>
              <td><div class="t-main"><%= seo_page_link(row.path, stack: true) %></div></td>
              <td>
                <%= row.query.present? ? seo_link(row.query, @presenter.search_path(row.query)) : seo_label(row.query) %>
                <div class="small text-body-secondary">position <%= row.position %></div>
              </td>
              <td class="num"><%= @presenter.number(row.clicks) %></td>
              <td class="num"><%= @presenter.number(row.visits) %></td>
              <% if @presenter.goals? %>
                <td class="num"><%= @presenter.converting_label(row) %></td>
                <td class="num t2"><%= @presenter.rate_label(row) %></td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      <% end %>

      <%= dash_card_footer do %><%= @presenter.mismatch_note %> <%= @presenter.named_note %><% if @presenter.goals? %> <%= @presenter.rate_note %><% end %><% end %>
      <%= dash_card_footer class: "sc-data-note" do %><%= @presenter.data_note %><% end %>
    <% end %>

    <% if @presenter.goals? && @presenter.leaking.any? %>
      <%= dash_card class: "mt-3" do %>
        <%= dash_card_header "Search traffic with no conversions" do %>
          <span class="g-hint">20 clicks or more, no conversion</span>
          <%= seo_csv(@presenter, "leaking") %>
        <% end %>

        <%= dash_table label: "Search traffic with no conversions", cols: "minmax(0, 1.6fr) minmax(0, 1.2fr) 72px 72px 76px" do %>
          <thead>
            <tr>
              <th scope="col">Page</th>
              <th scope="col">Top search</th>
              <th scope="col" class="num">Clicks</th>
              <th scope="col" class="num">Visits</th>
              <th scope="col" class="num">Position</th>
            </tr>
          </thead>
          <tbody>
            <% @presenter.leaking.each do |row| %>
              <tr>
                <td><div class="t-main"><%= seo_page_link(row.path, stack: true) %></div></td>
                <td><%= row.query.present? ? seo_link(row.query, @presenter.search_path(row.query)) : seo_label(row.query) %></td>
                <td class="num"><%= @presenter.number(row.clicks) %></td>
                <td class="num t2"><%= @presenter.number(row.visits) %></td>
                <td class="num t2"><%= row.position %></td>
              </tr>
            <% end %>
          </tbody>
        <% end %>

        <%= dash_card_footer do %>
          These pages rank and get clicks, but nobody converts. Check that the page answers the search and gives people a next step.
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
