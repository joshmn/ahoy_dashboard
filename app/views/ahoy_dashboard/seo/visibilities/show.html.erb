<% content_for :title, @presenter.title %>

<%= render layout: "ahoy_dashboard/seo/shared/shell", locals: { current: "visibility", site: @site } do %>
  <% controls = if @presenter.any? && @presenter.weightable?
       dash_segmented(@presenter.weighting_options.map { |option|
         { label: option[:label], url: option[:url], current: option[:active] }
       }, label: "Weighting")
     elsif @presenter.any?
       safe_join([
         dash_segmented(@presenter.weighting_options.first(1).map { |option|
           { label: option[:label], url: option[:url], current: true }
         }, label: "Weighting"),
         dash_unavailable(@presenter.weighting_options.last[:label], reason: @presenter.weighting_reason)
       ])
     end %>
  <%= render "ahoy_dashboard/seo/shared/head", presenter: @presenter, controls: controls %>

  <% if !@presenter.any? %>
    <%= dash_empty_card **@presenter.rank_empty(hint: "The score starts with the first check in the range. Try a longer date range.") %>
  <% else %>
    <%= render "ahoy_dashboard/seo/shared/tiles", tiles: @presenter.tiles %>

    <%= dash_card class: "mt-3" do %>
      <%= dash_card_header "Visibility over time" do %>
        <span class="g-hint">Share of the clicks your tracked searches could get</span>
      <% end %>

      <%= render "ahoy_dashboard/seo/shared/plot", points: @presenter.points,
            label: "Visibility over the range", height: 120 %>

      <%= dash_card_footer do %><%= @presenter.ceiling_note %><% end %>
    <% end %>

    <%= dash_card class: "mt-3" do %>
      <%= dash_card_header "Top contributors" do %>
        <span class="g-hint">Latest check of each search, biggest share first</span>
        <% if @presenter.contributors.any? %>
          <%= seo_csv(@presenter, "contributors") %>
        <% end %>
      <% end %>

      <% if @presenter.contributors.empty? %>
        <%= dash_empty compact: true, title: "Nothing is earning clicks yet",
              hint: "A search shows up here once it ranks high enough to be clicked." %>
      <% else %>
      <%= dash_table label: "Top contributors", cols: @presenter.table_cols do %>
        <thead>
          <tr>
            <th scope="col">Search</th>
            <% if @presenter.places? %><th scope="col">Place</th><% end %>
            <th scope="col" class="num">Position</th>
            <th scope="col" class="num">Click rate</th>
            <th scope="col" class="num">Points</th>
            <th scope="col" class="num">Share</th>
          </tr>
        </thead>
        <tbody>
          <% @presenter.contributors.each do |row| %>
            <tr>
              <td><div class="t-main"><%= seo_link(row.query, @presenter.tracked_path(row)) %></div></td>
              <% if @presenter.places? %>
                <td><%= seo_label(@presenter.place_label(row)) %></td>
              <% end %>
              <td class="num seo-pos"><%= row.position %></td>
              <td class="num t2"><%= @presenter.percent(row.ctr, places: 1) %></td>
              <td class="num"><%= row.points.round(2) %></td>
              <td>
                <%= seo_figure(@presenter.contribution(row), @presenter.percent(@presenter.contribution(row))) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      <% end %>
      <% end %>

      <%= dash_card_footer do %>Click rate is the typical rate for that position across the web, not measured on your site.<% end %>
    <% end %>

    <% if @presenter.dead.any? %>
      <%= dash_card class: "mt-3" do %>
        <%= dash_card_header "Not ranking" do %>
          <span class="g-hint"><%= pluralize(@presenter.dead.size, "search") %> not in the results</span>
          <%= seo_csv(@presenter, "not_ranking") %>
        <% end %>

        <div class="seo-chips">
          <% @presenter.dead.each do |row| %>
            <%= link_to @presenter.tracked_path(row), class: "seo-chip", title: row.query, data: { tm_frame: "_top" } do %>
              <span class="nm"><%= row.query %></span>
              <% if @presenter.places? %><span class="seo-chip__n"><%= @presenter.place_label(row) %></span><% end %>
            <% end %>
          <% end %>
        </div>

        <%= dash_card_footer do %>These still count toward the total, so dropping out of the results always lowers the score.<% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
