<% content_for :title, "AI visibility prompt" %>

<%= render layout: "ahoy_dashboard/seo/shared/shell", locals: { current: "ai_visibility" } do %>
  <% controls = dash_button("All prompts", @presenter.back_path, icon: :chevron_left, data: { tm_frame: "_top" }) %>
  <%= render "ahoy_dashboard/seo/shared/head", presenter: @presenter, sites: false, period: false, controls: controls,
        kicker: "AI visibility", title: @presenter.prompt.text, lede: @presenter.blurb %>

  <% if !@presenter.any? %>
    <%= dash_card do %>
      <%= dash_empty title: "Not asked yet", hint: "Answers to this prompt show here after the next run." %>
    <% end %>
  <% else %>
    <% @presenter.groups.each do |group| %>
      <%= dash_card class: "mt-3" do %>
        <%= dash_card_header group.label, level: :h2 do %>
          <span class="g-hint"><%= @presenter.summary(group) %></span>
        <% end %>

        <div class="p-3 d-flex flex-column gap-3">
          <% AhoyDashboard::AiVisibility::AnswerDecorator.wrap(group.answers).each_with_index do |answer, index| %>
            <details <%= "open" if index.zero? %>>
              <summary class="d-flex flex-wrap align-items-center gap-2">
                <span class="fw-semibold"><%= @presenter.asked_label(answer) %></span>
                <% if answer.failed? %>
                  <%= dash_badge "Failed", tone: :danger %>
                <% else %>
                  <%= answer.mentioned ? dash_badge("Mentioned", tone: :success) : dash_badge("Not mentioned") %>
                  <% if answer.cited %>
                    <%= dash_badge "Cited, position #{answer.position}", tone: :success %>
                  <% else %>
                    <%= dash_badge "Not cited" %>
                  <% end %>
                <% end %>
                <% if answer.served_differently? %><span class="small text-body-secondary font-monospace">served as <%= answer.served_model %></span><% end %>
              </summary>

              <div class="pt-2">
                <% if answer.failed? %>
                  <p class="mb-0 text-body-secondary"><%= answer.error.presence || "The request failed." %></p>
                <% else %>
                  <div class="text-break"><%= safe_join(@presenter.paragraphs(answer)) %></div>

                  <% if answer.sources.any? %>
                    <h3 class="h6 mt-3">Sources</h3>
                    <ol class="mb-0 small">
                      <% answer.sources.each do |source| %>
                        <li>
                          <%= link_to (source.title.presence || source.url), source.url, target: "_blank", rel: "noopener noreferrer nofollow", class: "seo-link text-break" %>
                          <span class="visually-hidden">, opens in a new tab</span>
                          <% if source.domain.present? %><span class="text-body-secondary font-monospace"><%= source.domain %></span><% end %>
                          <% if source.ours %><%= dash_badge "You", tone: :success %><% end %>
                        </li>
                      <% end %>
                    </ol>
                  <% else %>
                    <p class="mt-3 mb-0 small text-body-secondary">No sources cited.</p>
                  <% end %>
                <% end %>
              </div>
            </details>
          <% end %>
        </div>

        <% if @presenter.truncated_note(group) %>
          <%= dash_card_footer do %><%= @presenter.truncated_note(group) %><% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
