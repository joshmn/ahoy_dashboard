<% term = presenter.term.to_s %>
<% chip = dash_chip_kind(presenter.dimension.key) %>
<% mono = dash_mono_dimension?(presenter.dimension.key) %>
<% properties = presenter.property_options %>
<% breakdowns = presenter.breakdown_options %>

<% if report.tabs.many? || properties.any? || breakdowns.many? %>
  <div class="m-views">
    <% if report.tabs.many? %>
      <%= dash_tabs presenter.tabs.map { |option|
            { label: option.label, url: option.path, current: option.active?,
              data: { tm_frame: presenter.details_frame_id } }
          },
          label: "Views of #{report.title.downcase}", class: "m-views__tabs" %>
    <% end %>

    <% if properties.any? || breakdowns.many? %>
      <div class="m-views__pickers">
        <% if properties.any? %>
          <%= render "ahoy_dashboard/reports/property_picker",
                report: report, presenter: presenter, scope: "modal" %>
        <% end %>

        <%= render "ahoy_dashboard/reports/breakdown_picker",
              report: report, presenter: presenter, scope: "modal" %>
      </div>
    <% end %>
  </div>
<% end %>

<div class="m-search">
  <%= form_with url: report_path(report.key),
        method: :get,
        class: "d-flex align-items-center gap-2 w-100",
        data: { tm_frame: presenter.details_frame_id },
        html: { role: "search", "aria-label": "Search #{report.title.downcase}" } do %>
    <%= render "ahoy_dashboard/shared/query_fields" %>
    <%= dash_hidden_fields presenter.details_params.except(*query.to_query.keys, :page, :q) %>

    <%= dash_icon(:search, size: 15) %>
    <%= dash_search_field :q, term, label: "Find a row in #{report.title.downcase}", id: "tm-search-#{report.key}",
          size: :md, placeholder: "Search #{tab.label_column.downcase.pluralize}\u2026", spellcheck: false %>
    <kbd>esc</kbd>
  <% end %>
</div>

<%= dash_dialog_body list: true do %>
  <% if presenter.empty? %>
    <% if presenter.no_properties? %>
      <%= dash_empty "No custom properties in this range", compact: true,
            hint: "None of the events in this range carry a property of their own." %>
    <% elsif term.present? %>
      <%= dash_empty "Nothing matches that", compact: true,
            hint: "No #{presenter.label_heading.downcase.pluralize} here contain \u201C#{term}\u201D. Try a shorter search." %>
    <% else %>
      <%= dash_empty "Nothing here for this range", compact: true, hint: dash_range_hint %>
    <% end %>
  <% else %>
    <% presenter.rows.each do |row| %>
      <% current = row.filtered? %>
      <%= link_to root_path(row.toggle_params),
            class: class_names("data-row", "pinned" => current),
            title: current ? "Remove filter" : "Filter by #{row.display_label}",
            "aria-current": (current ? "true" : nil),
            data: { tm_frame: "_top" } do %>
        <%= dash_bar_tag(row.share, inset: 110) %>
        <%= dash_row_name row.display_label, chip: chip, chip_label: row.label, mono: mono %>
        <% if row.percent %>
          <span class="pct" title="<%= presenter.percent_title %>"><%= row.percent %></span>
        <% end %>
        <span class="cnt"><%= row.metric_value(presenter.columns.first) %></span>
        <% if current %>
          <span class="rx"><%= dash_icon(:close, size: 12) %></span>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% count = capture do %><%= presenter.count_label %><% if term.present? %> matching &ldquo;<%= term %>&rdquo;<% end %><% end %>
<%= dash_dialog_footer count do %>
    <% if term.present? %>
      <%= dash_button "Clear search",
            presenter.clear_search_path,
            tone: :link,
            data: { tm_frame: presenter.details_frame_id, tm_role: "clear" } %>
    <% end %>

    <% if presenter.previous_path %>
      <%= dash_button "Previous",
            presenter.previous_path,
            tone: :link,
            icon: :chevron_left,
            data: { tm_frame: presenter.details_frame_id, tm_role: "pager" } %>
    <% end %>

    <% if presenter.next_path %>
      <%= dash_button "Next",
            presenter.next_path,
            tone: :link,
            icon_end: :chevron_right,
            data: { tm_frame: presenter.details_frame_id, tm_role: "pager" } %>
    <% end %>

    <%= dash_button "Open in Explore", presenter.explore_path, tone: :link, icon_end: :expand,
          data: { tm_frame: "_top" } %>

    <%= dash_button "CSV", presenter.export_path, tone: :link, icon: :download,
          data: { tm_frame: "_top" } %>
<% end %>
