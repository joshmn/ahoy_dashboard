<% if @presenter.details? %>
  <%= dash_frame_tag @presenter.details_frame_id do %>
    <%= render "ahoy_dashboard/reports/details", report: @report, tab: @tab, presenter: @presenter %>
  <% end %>
<% else %>
  <%= dash_frame_tag @presenter.frame_id do %>
    <% dash_snapshot_cache([:report, @report.key], snapshot: @snapshot) do %>
      <%= render "ahoy_dashboard/reports/card", report: @report, tab: @tab, presenter: @presenter %>
    <% end %>
  <% end %>
<% end %>
