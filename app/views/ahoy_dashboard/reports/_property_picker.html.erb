<% scope = local_assigns.fetch(:scope, "card") %>
<% picker_id = "tm-#{scope}-#{report.key}-property" %>
<% showing = presenter.property_name %>

<%= dash_menu id: picker_id, label: showing, toggle: :tab, align: :end, aria_label: "Custom property: #{showing}",
      panel_class: "tm-scroll", data: { tm_picker: "property" } do %>
  <%= dash_menu_header "Property" %>

  <% presenter.property_options.each do |option| %>
    <%= dash_menu_item option.label, option.path, current: option.active? %>
  <% end %>
<% end %>
