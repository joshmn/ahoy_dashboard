<% scope = local_assigns.fetch(:scope, "card") %>
<% picker_id = "tm-#{scope}-#{report.key}-views" %>
<% holding = tabs.any?(&:active?) %>
<% picker_label = holding ? presenter.tab.label : "More" %>

<%= dash_menu id: picker_id, label: picker_label, toggle: :tab, chevron: true, pressed: holding, align: :end,
      aria_label: "#{picker_label} views for #{report.title.downcase}", panel_class: "tm-scroll" do %>
  <%= dash_menu_header "Break down by" %>

  <% tabs.each do |option| %>
    <%= dash_menu_item option.label, option.path, current: option.active? %>
  <% end %>
<% end %>
