<% if presenter.no_properties? %>
  <%= dash_empty "No custom properties in this range", compact: true,
        hint: "None of the events in this range carry a property of their own.",
        action: { label: "Custom properties", url: settings_properties_path, primary: false,
                  data: { tm_frame: "_top" } } %>
<% elsif presenter.empty? %>
  <%= dash_empty "Nothing here for this range", compact: true, hint: dash_range_hint %>
<% else %>
  <% chip = dash_chip_kind(tab.resolved_dimension_key) %>
  <% mono = dash_mono_dimension?(tab.resolved_dimension_key) %>

  <div class="p-list">
    <% presenter.rows.each do |row| %>
      <%= link_to root_path(row.filter_params),
            class: "data-row",
            title: "Filter by #{row.display_label}",
            data: { tm_frame: "_top" } do %>
        <%= dash_bar_tag(row.share) %>
        <%= dash_row_name row.display_label, chip: chip, chip_label: row.label, mono: mono %>
        <% if row.percent %>
          <span class="pct" title="<%= presenter.percent_title %>"><%= row.percent %></span>
        <% end %>
        <% presenter.columns.each do |column| %>
          <span class="cnt"><%= row.metric_value(column) %></span>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
