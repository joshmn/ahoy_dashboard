<% font = "font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;" %>
<% content_for :preheader, @digest.preheader %>
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width: 100%; max-width: 600px; background-color: #ffffff; border: 1px solid #e2e4e9; border-radius: 10px;">
  <tr>
    <td style="padding: 16px 24px; border-bottom: 1px solid #eceef2; <%= font %>">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="font-size: 14px; font-weight: 600; color: #1b1d22; <%= font %>"><span style="display: inline-block; width: 12px; height: 12px; margin-right: 8px; vertical-align: -1px; background-color: #5e6ad2; border-radius: 3px;"></span><%= @digest.host %></td>
          <td align="right" style="font-size: 13px; color: #6b7280; <%= font %>"><%= @digest.cadence %> alerts</td>
        </tr>
      </table>
    </td>
  </tr>
  <tr>
    <td style="padding: 24px 24px <%= @digest.groups.any? ? 8 : 26 %>px; <%= font %>">
      <p style="margin: 0 0 4px; font-size: 13px; color: #6b7280;"><%= @digest.period_heading %></p>
      <h1 style="margin: 0 0 6px; font-size: 22px; line-height: 1.3; font-weight: 600; color: #111318;"><%= @digest.headline %></h1>
      <p style="margin: 0 0 22px; font-size: 16px; line-height: 1.5; color: #3f4652;"><%= @digest.summary %></p>
      <% if @digest.invented? %>
        <p style="margin: 0 0 20px; padding: 12px 14px; background-color: #fdf6e7; border-left: 3px solid #d2a65e; font-size: 14px; line-height: 1.5; color: #5c4813;"><%= @digest.invented_note %></p>
      <% end %>
      <% @digest.waiting_notes.each do |note| %>
        <p style="margin: 0 0 20px; padding: 12px 14px; background-color: #eef0f3; border-left: 3px solid #9aa1ad; font-size: 14px; line-height: 1.5; color: #3f4652;"><%= note %></p>
      <% end %>
      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="background-color: #5e6ad2; border-radius: 6px;"><%= link_to "Open alerts", @links[:alerts], style: "display: inline-block; padding: 11px 18px; font-size: 15px; font-weight: 600; color: #ffffff; text-decoration: none; #{font}" %></td>
          <td style="padding-left: 18px; font-size: 15px; <%= font %>"><%= link_to "See rankings", @links[:rankings], style: "color: #4f5bd5; text-decoration: underline;" %></td>
        </tr>
      </table>
    </td>
  </tr>
  <% if @digest.groups.any? %>
    <tr>
      <td style="padding: 8px 24px 24px; <%= font %>">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
          <% @digest.groups.each do |group| %>
            <tr>
              <td colspan="2" style="padding: 18px 0 8px;"><span style="display: inline-block; padding: 2px 8px; border-radius: 999px; background-color: <%= group.background %>; color: <%= group.color %>; font-size: 12px; font-weight: 600; line-height: 1.4; <%= font %>"><%= group.label %></span></td>
            </tr>
            <% group.rows.each do |row| %>
              <tr>
                <td style="padding: 12px 0; border-top: 1px solid #eceef2; vertical-align: top; <%= font %>">
                  <div style="font-size: 15px; line-height: 1.4; font-weight: 600; color: #111318;"><%= row.headline %></div>
                  <div style="padding-top: 3px; font-size: 14px; line-height: 1.45; color: #4b5563;"><%= row.detail %> <span style="color: #6b7280;"><%= row.rule %>.</span></div>
                </td>
                <td width="72" align="right" style="padding: 14px 0 12px 12px; border-top: 1px solid #eceef2; vertical-align: top; font-size: 13px; color: #6b7280; white-space: nowrap; <%= font %>"><%= row.at %></td>
              </tr>
            <% end %>
          <% end %>
        </table>
        <% if @digest.more? %>
          <p style="margin: 16px 0 0; font-size: 14px; color: #4b5563;"><%= @digest.more_label %> <%= link_to @digest.more_link_label, @links[:alerts], style: "color: #4f5bd5; text-decoration: underline;" %>.</p>
        <% end %>
      </td>
    </tr>
  <% end %>
  <tr>
    <td style="padding: 16px 24px; border-top: 1px solid #eceef2; background-color: #fafafb; border-radius: 0 0 10px 10px; font-size: 13px; line-height: 1.5; color: #6b7280; <%= font %>">
      <%= @digest.footer %> <%= link_to "Change or turn off rules", @links[:rules], style: "color: #6b7280; text-decoration: underline;" %>.
    </td>
  </tr>
</table>
