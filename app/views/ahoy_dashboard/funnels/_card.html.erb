<%= dash_card element: :section, class: "panel h-100", "aria-labelledby": "tm-card-#{presenter.modal_key}-title" do %>
  <%= dash_card_header presenter.title, id: "tm-card-#{presenter.modal_key}-title", element: :header %>

  <%= render "ahoy_dashboard/funnels/rows", presenter: presenter %>

  <%= dash_details_opener presenter.details_path,
        frame: AhoyDashboard::FunnelPresenter.details_frame_id(presenter.funnel), key: presenter.modal_key do %>
    <span>Details</span>
    <%= dash_icon(:chevron_right) %>
  <% end %>
<% end %>
