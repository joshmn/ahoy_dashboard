<%# Read off the funnel's own steps, so the card that lands cannot show a
    different title or a different number of rows than the shape it replaced. %>
<%= dash_card element: :section, class: "panel h-100", "aria-busy": "true" do %>
  <%= dash_card_header funnel.name, element: :header %>

  <div class="p-list placeholder-glow" aria-hidden="true">
    <% step_count.times do |step| %>
      <span class="placeholder col-<%= [ 12 - step, 3 ].max %> rounded py-2"></span>
    <% end %>
  </div>

  <span class="visually-hidden">Loading the <%= funnel.name.downcase %> funnel</span>
<% end %>
