<% frame = AhoyDashboard::RealtimeController::FRAME %>
<% if params[:view] == "panel" %>
  <%= dash_frame_tag frame do %>
    <%= render "ahoy_dashboard/realtime/panel", snapshot: @snapshot %>
  <% end %>
<% else %>
<% content_for :title, "Realtime" %>
<% pause = "Pause refreshing" %>

<section class="rt-page"
         data-controller="dash--realtime"
         data-dash--realtime-frame-value="<%= frame %>"
         data-dash--realtime-pause-text-value="<%= pause %>"
         data-dash--realtime-resume-text-value="Resume refreshing">
  <%= dash_page_head title: "Realtime",
        lede: "Who is on your site right now.",
        actions: dash_button(pause, hidden: true,
                             data: { "dash--realtime-target": "toggle", action: "dash--realtime#toggle" }) %>

  <%= dash_frame_tag frame,
        src: realtime_path(view: "panel"), rendered: true do %>
    <%= render "ahoy_dashboard/realtime/panel", snapshot: @snapshot %>
  <% end %>
</section>
<% end %>
