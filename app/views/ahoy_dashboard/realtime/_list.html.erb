<% mono = local_assigns[:mono] %>

<%= dash_card element: :section, class: "panel h-100" do %>
  <%= dash_card_header title, element: :header do %>
    <span class="g-hint">Visitors</span>
  <% end %>

  <% if rows.empty? %>
    <%= dash_empty title: "Nothing to show yet", fill: true, compact: true %>
  <% else %>
    <div class="p-list">
      <% rows.each do |row| %>
        <div class="data-row" title="<%= row.label %>">
          <%= dash_bar_tag(row.share) %>
          <%= dash_row_name row.label, chip: chip, mono: mono %>
          <span class="cnt"><%= dash_number(row.visitors) %></span>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
