<% minutes = pluralize((snapshot.window.to_f / 60).round, "minute") %>

<div class="tm-live__panel">
  <p class="rt-count">
    <span class="tm-live__number"><%= dash_number(snapshot.visitors) %></span>
    <span class="t-when">
      <%= snapshot.visitors == 1 ? "visitor" : "visitors" %> in the last <%= minutes %>
    </span>
  </p>

  <% if snapshot.visitors.zero? %>
    <%= dash_card do %>
      <%= dash_empty title: "No one is on the site right now",
            hint: "New visits show up here as they happen." %>
    <% end %>
  <% else %>
    <div class="row row-cols-1 row-cols-md-2 g-3">
      <div class="col"><%= render "ahoy_dashboard/realtime/list", title: "Pages", rows: snapshot.pages, chip: nil, mono: true %></div>
      <div class="col"><%= render "ahoy_dashboard/realtime/list", title: "Sources", rows: snapshot.sources, chip: :favicon, mono: false %></div>
    </div>
  <% end %>
</div>
