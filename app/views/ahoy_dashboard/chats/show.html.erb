<% content_for :title, "#{@chat.title_or_default} - Ask" %>
<% available = AhoyDashboard::Assistant.available? %>

<section class="ask-page">
  <%= dash_page_head title: @chat.title_or_default, clip: true,
        lede: "Answers come from the same data as the dashboard.",
        actions: capture {
          dash_button_to("New question", chats_path, method: :post,
                         reason: (AhoyDashboard::Settings::Display.assistant_notice unless available)) +
            dash_button("All conversations", chats_path)
        } %>

  <% unless available %>
    <%= render "ahoy_dashboard/chats/unavailable" %>
  <% end %>

  <%= dash_card class: "chat-card",
        data: { controller: "dash--chat-ask",
                action: "keydown->dash--chat-ask#keydown",
                "chat-fresh": @chat.chat_messages.none?.to_s } do %>
    <%= dash_card_header "Conversation" do %>
      <% if @chat.chat_messages.any? %>
        <%= dash_button_to "Delete", chat_path(@chat), method: :delete, tone: :danger,
              confirm: "Delete this conversation?" %>
      <% end %>
    <% end %>

    <%= render "ahoy_dashboard/chats/thread", chat: @chat %>

    <%= render "ahoy_dashboard/chats/composer", url: chat_messages_path(@chat), id: "message_content",
          label: "Ask about the data", placeholder: "Ask about traffic, searches or rankings",
          available: available, autofocus: available %>
  <% end %>
</section>
