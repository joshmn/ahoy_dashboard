<div class="cmdk" id="tm-palette" hidden data-dash--palette-target="panel"
     data-commands-url="<%= palette.path %>"
     data-search-url="<%= content_for(:dash_palette_search).presence || facet_search_path(query.to_query) %>">
  <div class="cmdk-bg" data-action="click->dash--palette#close"></div>

  <div class="cmdk-panel" role="dialog" aria-modal="true" aria-label="Search pages, sources and settings">
    <div class="cmdk-in">
      <%= dash_icon(:search, size: 15) %>
      <input type="text"
             placeholder="Search pages, sources and settings"
             autocomplete="off"
             spellcheck="false"
             role="combobox"
             aria-expanded="true"
             aria-autocomplete="list"
             aria-label="Search pages, sources and settings"
             aria-controls="tm-palette-list"
             data-dash--palette-target="input"
             data-action="input->dash--palette#filter">
      <kbd>esc</kbd>
    </div>

    <div class="cmdk-list" id="tm-palette-list" role="listbox">
      <div data-dash--palette-target="commands" aria-busy="false">
        <p class="ck-empty" data-dash--palette-target="loading" role="status">Loading commands…</p>
        <p class="ck-empty" data-dash--palette-target="failure" hidden>
          Commands could not be loaded. <%= link_to "Open commands as a page", palette.path, data: { tm_frame: "_top" } %>
        </p>
      </div>

      <div data-dash--palette-target="found" aria-busy="false"></div>

      <p class="ck-empty" hidden data-dash--palette-target="none"
         data-searching="Searching this range for that&hellip;"
         data-short="No command matches that. One more letter searches pages and sources too."
         data-empty="No command and no value matches that in this range.">No command and no value matches that in this range.</p>
    </div>

    <p class="visually-hidden" role="status" data-dash--palette-target="status"></p>

    <div class="cmdk-ft">
      <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> open or filter</span>
    </div>
  </div>
</div>
