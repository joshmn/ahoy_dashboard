<% skipped = Array(local_assigns[:except]).map(&:to_s) %>
<%= dash_hidden_fields(query.to_query.reject { |name, value|
      name.to_s == "filters" || skipped.include?(name.to_s) || value.nil? || value.to_s.empty?
    }) %>
<% dropped = local_assigns[:except_filter] %>
<% numbered = local_assigns[:numbered] %>
<% if query.filters.none? && query.carried_filters.present? && !local_assigns.key?(:except_filter) %>
  <%= hidden_field_tag "filters", query.carried_filters, id: nil %>
<% end %>
<% index = -1 %>
<% query.filters.groups.each_with_index do |group, position| %>
  <% group.each do |filter| %>
    <% index += 1 %>
    <% next if dropped.present? && index == dropped.to_i %>
    <% fields = filter.to_param %>
    <% fields = fields.merge(AhoyDashboard::Filters::GROUP => position) if !group.single? || position == numbered %>
    <% fields.each do |name, value| %>
      <%= hidden_field_tag "filters[][#{name}]", value, id: nil %>
    <% end %>
  <% end %>
<% end %>
