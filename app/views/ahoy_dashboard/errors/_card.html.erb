<% back = public_send(error.back_route) %>
<%= dash_card do %>
  <%= dash_empty title: error.heading, hint: error.hint,
        action: error.primary_action(back), secondary: error.secondary_action(back) %>
  <%= dash_card_footer do %>
    <% error.details.each_with_index do |detail, index| %><% if index.positive? %> &middot; <% end %><span class="mono"><%= detail %></span><% end %>
  <% end %>
<% end %>
