<%# One value in the filter dialog. Live, it is a toggle the dialog collects
    into a filter, and nothing happens until Apply. As a page, with no dialog
    around it, it is a link that applies the value on its own. %>
<% typed = local_assigns.fetch(:typed, false) %>
<% largest = local_assigns.fetch(:largest, 0).to_f %>
<% visitors = local_assigns[:visitors] %>
<% mono = dash_mono_dimension?(dimension.key) %>
<% chip = dash_chip_kind(dimension.key) %>
<% chip = nil unless chip.in?(%i[flag channel]) %>
<% body = capture do %>
  <%= dash_check_mark(class: "position-relative fm-row__check") %>
  <% unless typed %>
    <%= dash_bar_tag(largest.positive? ? visitors.to_f / largest : 0, inset: 110) %>
  <% end %>
  <span class="<%= class_names("rn", "mono" => mono) %>">
    <% if typed %>
      <span class="nm">Use &ldquo;<span class="<%= class_names("text-body-emphasis", "mono" => mono) %>"><%= value %></span>&rdquo;</span>
    <% else %>
      <%= dash_row_chip(chip, value) if chip %>
      <%= dash_row_label(value, split: mono) %>
    <% end %>
  </span>
  <% unless typed %>
    <span class="cnt"><%= dash_number(visitors) %></span>
  <% end %>
<% end %>

<% if live %>
  <%= button_tag body, type: "button", class: "data-row fm-row", "aria-pressed": "false",
        data: { dimension: dimension.key, label: dimension.filter_label, value: value, typed: ("" if typed),
                action: "dash--filter-modal#pick" } %>
<% else %>
  <%= link_to body, dash_destination_path(destination, query.filter_link_params(dimension.key, value).merge(carried)),
        class: "data-row fm-row" %>
<% end %>
