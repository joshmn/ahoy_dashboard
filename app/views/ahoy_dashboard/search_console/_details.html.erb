<div class="sc-scope" data-controller="dash--check-all">

<div class="m-views">
  <%= dash_tabs presenter.tabs.map { |option|
        { label: option.label, url: option.path, current: option.active?,
          data: { tm_frame: AhoyDashboard::SearchConsolePresenter::DETAILS_FRAME } }
      },
      label: "Views of #{presenter.title.downcase}", class: "m-views__tabs" %>
</div>

<% unless presenter.unconfigured? || presenter.empty? %>
  <%= render "ahoy_dashboard/search_console/columns", presenter: presenter %>
<% end %>

<%= dash_dialog_body list: true do %>
  <% if presenter.unconfigured? %>
    <%= render "ahoy_dashboard/search_console/unconnected" %>
  <% elsif presenter.empty? %>
    <%= dash_empty "Nothing back from Google for this range", hint: presenter.lag_note, compact: true %>
  <% else %>
    <%= render partial: "ahoy_dashboard/search_console/line", collection: presenter.rows, as: :row,
          locals: { presenter: presenter, form: presenter.track_form_id } %>
  <% end %>
<% end %>

<% if presenter.problem_note.present? %>
  <p class="m-note small text-body-secondary">
    <%= presenter.problem_note %>
    <%= link_to "Fix connection", settings_google_connection_path, data: { tm_frame: "_top" } %>
  </p>
<% end %>

<% if presenter.through_note.present? %>
  <p class="m-note small text-body-secondary"><%= presenter.through_note %></p>
<% end %>

<% if presenter.coverage_note.present? %>
  <p class="m-note small text-body-secondary"><%= presenter.coverage_note %></p>
<% end %>

<%= dash_dialog_footer "#{presenter.rows.size} #{presenter.label_column.downcase.pluralize(presenter.rows.size)}" do %>
  <% if presenter.track_form_id %>
    <%= seo_track_form presenter.track_form_id, return_to: root_path(query.to_query) %>
  <% end %>
  <% connection_label = presenter.unconfigured? ? "Set up Search Console" : "Connection" %>
  <%= dash_button connection_label, settings_google_connection_path,
        tone: :link, icon_end: :chevron_right, data: { tm_frame: "_top" } %>
<% end %>

</div>
