<%# Read off the presenter's own registry so the frame that lands cannot show a
    different title than the skeleton it replaces. %>
<%= dash_card element: :section, class: "panel h-100", "aria-busy": "true" do %>
  <%= dash_card_header AhoyDashboard::SearchConsolePresenter::TITLE, element: :header %>

  <div class="p-list placeholder-glow" aria-hidden="true">
    <% [ 12, 10, 8, 7, 6, 5, 4, 3, 3 ].each do |width| %>
      <span class="placeholder col-<%= width %> rounded py-2"></span>
    <% end %>
  </div>

  <span class="visually-hidden">Loading <%= AhoyDashboard::SearchConsolePresenter::TITLE.downcase %></span>
<% end %>
