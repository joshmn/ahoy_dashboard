<% if @details %>
  <%= dash_frame_tag @presenter.frame_id do %>
    <%= render "ahoy_dashboard/search_console/details", presenter: @presenter %>
  <% end %>
<% else %>
  <%= dash_frame_tag @presenter.frame_id do %>
    <%= render "ahoy_dashboard/search_console/card", presenter: @presenter %>
  <% end %>
<% end %>
